[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.615,
  "text": "It's 11:59 p.m."
 },
 {
  "i": 1,
  "start": 1.615,
  "end": 4.565,
  "text": "Your phone is face down on the nightstand."
 },
 {
  "i": 2,
  "start": 4.715,
  "end": 5.846,
  "text": "It buzzes once."
 },
 {
  "i": 3,
  "start": 5.996,
  "end": 7.191,
  "text": "You flip it over."
 },
 {
  "i": 4,
  "start": 7.691,
  "end": 9.589,
  "text": "Forty-six new notifications."
 },
 {
  "i": 5,
  "start": 9.739,
  "end": 10.571,
  "text": "Normal."
 },
 {
  "i": 6,
  "start": 10.721,
  "end": 13.196,
  "text": "Except every single one is stamped tomorrow."
 },
 {
  "i": 7,
  "start": 13.696,
  "end": 15.276,
  "text": "Tomorrow, 7:02 a.m."
 },
 {
  "i": 8,
  "start": 15.276,
  "end": 17.131,
  "text": "Mom: Don't forget your lunch."
 },
 {
  "i": 9,
  "start": 17.281,
  "end": 18.972,
  "text": "Tomorrow, 10:15 a.m."
 },
 {
  "i": 10,
  "start": 18.972,
  "end": 20.737,
  "text": "School alert: Fire drill."
 },
 {
  "i": 11,
  "start": 21.237,
  "end": 22.346,
  "text": "You go to sleep."
 },
 {
  "i": 12,
  "start": 22.496,
  "end": 25.205,
  "text": "At 7:02, a voice comes up the stairs."
 },
 {
  "i": 13,
  "start": 25.705,
  "end": 26.324,
  "text": "Maya!"
 },
 {
  "i": 14,
  "start": 26.474,
  "end": 27.626,
  "text": "Don't forget your lunch!"
 },
 {
  "i": 15,
  "start": 28.126,
  "end": 30.729,
  "text": "At 10:15, the fire alarm goes off."
 },
 {
  "i": 16,
  "start": 30.879,
  "end": 32.201,
  "text": "Exactly on time."
 },
 {
  "i": 17,
  "start": 32.701,
  "end": 34.045,
  "text": "Your name is Maya."
 },
 {
  "i": 18,
  "start": 34.195,
  "end": 35.283,
  "text": "You're sixteen."
 },
 {
  "i": 19,
  "start": 35.433,
  "end": 37.439,
  "text": "And your phone just showed you tomorrow."
 },
 {
  "i": 20,
  "start": 37.589,
  "end": 40.959,
  "text": "So what if your phone showed tomorrow's notifications today?"
 },
 {
  "i": 21,
  "start": 41.459,
  "end": 42.59,
  "text": "Here's the rule."
 },
 {
  "i": 22,
  "start": 42.74,
  "end": 48.116,
  "text": "Every night at 11:59, tomorrow's notifications land on your lock screen."
 },
 {
  "i": 23,
  "start": 48.266,
  "end": 49.162,
  "text": "The time."
 },
 {
  "i": 24,
  "start": 49.312,
  "end": 50.208,
  "text": "The sender."
 },
 {
  "i": 25,
  "start": 50.358,
  "end": 51.937,
  "text": "The first forty characters."
 },
 {
  "i": 26,
  "start": 52.087,
  "end": 53.431,
  "text": "You can't open them."
 },
 {
  "i": 27,
  "start": 53.581,
  "end": 54.839,
  "text": "You can't reply."
 },
 {
  "i": 28,
  "start": 54.989,
  "end": 58.019,
  "text": "And you'll learn the hard way: tomorrow keeps count."
 },
 {
  "i": 29,
  "start": 58.519,
  "end": 64.94,
  "text": "One industry study found the average American gets about 46 push notifications a day."
 },
 {
  "i": 30,
  "start": 65.09,
  "end": 66.711,
  "text": "You get yours a day early."
 },
 {
  "i": 31,
  "start": 67.211,
  "end": 68.065,
  "text": "Day one."
 },
 {
  "i": 32,
  "start": 68.215,
  "end": 69.924,
  "text": "Tomorrow, 8:05 a.m."
 },
 {
  "i": 33,
  "start": 69.924,
  "end": 70.422,
  "text": "Mr."
 },
 {
  "i": 34,
  "start": 70.422,
  "end": 73.057,
  "text": "Okafor posted: Pop quiz, chapter seven."
 },
 {
  "i": 35,
  "start": 73.207,
  "end": 75.277,
  "text": "So tonight, you read chapter seven."
 },
 {
  "i": 36,
  "start": 75.427,
  "end": 76.152,
  "text": "Twice."
 },
 {
  "i": 37,
  "start": 76.652,
  "end": 78.081,
  "text": "Here's the real part."
 },
 {
  "i": 38,
  "start": 78.231,
  "end": 82.306,
  "text": "Without review, most people forget most of something new within a day."
 },
 {
  "i": 39,
  "start": 82.456,
  "end": 84.547,
  "text": "Scientists call it the forgetting curve."
 },
 {
  "i": 40,
  "start": 84.697,
  "end": 86.467,
  "text": "You reviewed at eleven p.m."
 },
 {
  "i": 41,
  "start": 86.467,
  "end": 87.897,
  "text": "Twenty out of twenty."
 },
 {
  "i": 42,
  "start": 88.397,
  "end": 89.335,
  "text": "You studied?"
 },
 {
  "i": 43,
  "start": 89.485,
  "end": 90.445,
  "text": "On purpose?"
 }
]