[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.615,
  "text": "It's 11:59 p.m."
 },
 {
  "i": 1,
  "start": 1.615,
  "end": 4.565,
  "text": "Your phone is face down on the nightstand."
 },
 {
  "i": 2,
  "start": 4.715,
  "end": 5.846,
  "text": "It buzzes once."
 },
 {
  "i": 3,
  "start": 5.996,
  "end": 7.191,
  "text": "You flip it over."
 },
 {
  "i": 4,
  "start": 7.691,
  "end": 9.589,
  "text": "Forty-six new notifications."
 },
 {
  "i": 5,
  "start": 9.739,
  "end": 10.571,
  "text": "Normal."
 },
 {
  "i": 6,
  "start": 10.721,
  "end": 13.196,
  "text": "Except every single one is stamped tomorrow."
 },
 {
  "i": 7,
  "start": 13.696,
  "end": 15.276,
  "text": "Tomorrow, 7:02 a.m."
 },
 {
  "i": 8,
  "start": 15.276,
  "end": 17.131,
  "text": "Mom: Don't forget your lunch."
 },
 {
  "i": 9,
  "start": 17.281,
  "end": 18.972,
  "text": "Tomorrow, 10:15 a.m."
 },
 {
  "i": 10,
  "start": 18.972,
  "end": 20.737,
  "text": "School alert: Fire drill."
 },
 {
  "i": 11,
  "start": 21.237,
  "end": 22.346,
  "text": "You go to sleep."
 },
 {
  "i": 12,
  "start": 22.496,
  "end": 25.205,
  "text": "At 7:02, a voice comes up the stairs."
 },
 {
  "i": 13,
  "start": 25.705,
  "end": 26.324,
  "text": "Maya!"
 },
 {
  "i": 14,
  "start": 26.474,
  "end": 27.626,
  "text": "Don't forget your lunch!"
 },
 {
  "i": 15,
  "start": 28.126,
  "end": 30.729,
  "text": "At 10:15, the fire alarm goes off."
 },
 {
  "i": 16,
  "start": 30.879,
  "end": 32.201,
  "text": "Exactly on time."
 },
 {
  "i": 17,
  "start": 32.701,
  "end": 34.045,
  "text": "Your name is Maya."
 },
 {
  "i": 18,
  "start": 34.195,
  "end": 35.283,
  "text": "You're sixteen."
 },
 {
  "i": 19,
  "start": 35.433,
  "end": 37.439,
  "text": "And your phone just showed you tomorrow."
 },
 {
  "i": 20,
  "start": 37.589,
  "end": 40.959,
  "text": "So what if your phone showed tomorrow's notifications today?"
 },
 {
  "i": 21,
  "start": 41.459,
  "end": 42.59,
  "text": "Here's the rule."
 },
 {
  "i": 22,
  "start": 42.74,
  "end": 48.116,
  "text": "Every night at 11:59, tomorrow's notifications land on your lock screen."
 },
 {
  "i": 23,
  "start": 48.266,
  "end": 49.162,
  "text": "The time."
 },
 {
  "i": 24,
  "start": 49.312,
  "end": 50.208,
  "text": "The sender."
 },
 {
  "i": 25,
  "start": 50.358,
  "end": 51.937,
  "text": "The first forty characters."
 },
 {
  "i": 26,
  "start": 52.087,
  "end": 53.431,
  "text": "You can't open them."
 },
 {
  "i": 27,
  "start": 53.581,
  "end": 54.839,
  "text": "You can't reply."
 },
 {
  "i": 28,
  "start": 54.989,
  "end": 58.019,
  "text": "And you'll learn the hard way: tomorrow keeps count."
 },
 {
  "i": 29,
  "start": 58.519,
  "end": 64.94,
  "text": "One industry study found the average American gets about 46 push notifications a day."
 },
 {
  "i": 30,
  "start": 65.09,
  "end": 66.711,
  "text": "You get yours a day early."
 },
 {
  "i": 31,
  "start": 67.211,
  "end": 68.065,
  "text": "Day one."
 },
 {
  "i": 32,
  "start": 68.215,
  "end": 69.924,
  "text": "Tomorrow, 8:05 a.m."
 },
 {
  "i": 33,
  "start": 69.924,
  "end": 70.422,
  "text": "Mr."
 },
 {
  "i": 34,
  "start": 70.422,
  "end": 73.057,
  "text": "Okafor posted: Pop quiz, chapter seven."
 },
 {
  "i": 35,
  "start": 73.207,
  "end": 75.277,
  "text": "So tonight, you read chapter seven."
 },
 {
  "i": 36,
  "start": 75.427,
  "end": 76.152,
  "text": "Twice."
 },
 {
  "i": 37,
  "start": 76.652,
  "end": 78.081,
  "text": "Here's the real part."
 },
 {
  "i": 38,
  "start": 78.231,
  "end": 82.306,
  "text": "Without review, most people forget most of something new within a day."
 },
 {
  "i": 39,
  "start": 82.456,
  "end": 84.547,
  "text": "Scientists call it the forgetting curve."
 },
 {
  "i": 40,
  "start": 84.697,
  "end": 86.467,
  "text": "You reviewed at eleven p.m."
 },
 {
  "i": 41,
  "start": 86.467,
  "end": 87.897,
  "text": "Twenty out of twenty."
 },
 {
  "i": 42,
  "start": 88.397,
  "end": 89.335,
  "text": "You studied?"
 },
 {
  "i": 43,
  "start": 89.485,
  "end": 90.445,
  "text": "On purpose?"
 },
 {
  "i": 44,
  "start": 90.945,
  "end": 95.767,
  "text": "Mom gets home at seven every morning after a twelve-hour shift at Mercy General."
 },
 {
  "i": 45,
  "start": 95.917,
  "end": 97.175,
  "text": "She calls a lot."
 },
 {
  "i": 46,
  "start": 97.325,
  "end": 98.413,
  "text": "Like, a lot."
 },
 {
  "i": 47,
  "start": 98.913,
  "end": 100.897,
  "text": "She holds out her hand for your phone."
 },
 {
  "i": 48,
  "start": 101.397,
  "end": 102.656,
  "text": "Put me in your favorites."
 },
 {
  "i": 49,
  "start": 102.806,
  "end": 104.705,
  "text": "Do Not Disturb lets favorites through."
 },
 {
  "i": 50,
  "start": 104.855,
  "end": 106.156,
  "text": "So I always get through."
 },
 {
  "i": 51,
  "start": 106.656,
  "end": 108.085,
  "text": "You take the phone back."
 },
 {
  "i": 52,
  "start": 108.585,
  "end": 109.097,
  "text": "Mom."
 },
 {
  "i": 53,
  "start": 109.247,
  "end": 109.802,
  "text": "Later."
 },
 {
  "i": 54,
  "start": 110.302,
  "end": 114.526,
  "text": "Your little brother Sam, nine, is eating cereal out of a mixing bowl."
 },
 {
  "i": 55,
  "start": 115.026,
  "end": 115.943,
  "text": "Later means never."
 },
 {
  "i": 56,
  "start": 116.443,
  "end": 117.403,
  "text": "Day three."
 },
 {
  "i": 57,
  "start": 117.553,
  "end": 119.142,
  "text": "Tomorrow, 3:40 p.m."
 },
 {
  "i": 58,
  "start": 119.142,
  "end": 121.628,
  "text": "Weather: Severe thunderstorm warning."
 },
 {
  "i": 59,
  "start": 121.778,
  "end": 123.826,
  "text": "Track practice is at 3:30."
 },
 {
  "i": 60,
  "start": 123.976,
  "end": 124.936,
  "text": "Outside."
 },
 {
  "i": 61,
  "start": 125.086,
  "end": 127.518,
  "text": "The forecast says ten percent chance of rain."
 },
 {
  "i": 62,
  "start": 128.018,
  "end": 131.794,
  "text": "A five-day forecast is right about ninety percent of the time."
 },
 {
  "i": 63,
  "start": 131.944,
  "end": 133.949,
  "text": "A ten-day forecast, about half."
 },
 {
  "i": 64,
  "start": 134.099,
  "end": 135.827,
  "text": "Yours is right every time."
 },
 {
  "i": 65,
  "start": 135.977,
  "end": 137.407,
  "text": "You bring a rain jacket."
 },
 {
  "i": 66,
  "start": 137.557,
  "end": 139.583,
  "text": "At 3:40 the sky opens."
 },
 {
  "i": 67,
  "start": 140.083,
  "end": 141.15,
  "text": "How did you know?"
 },
 {
  "i": 68,
  "start": 141.3,
  "end": 143.092,
  "text": "The app said ten percent!"
 },
 {
  "i": 69,
  "start": 143.592,
  "end": 144.552,
  "text": "Day five."
 },
 {
  "i": 70,
  "start": 144.702,
  "end": 146.759,
  "text": "Tomorrow, 9:47 p.m."
 },
 {
  "i": 71,
  "start": 146.759,
  "end": 148.969,
  "text": "Ava: hey are you going to the..."
 },
 {
  "i": 72,
  "start": 149.119,
  "end": 150.484,
  "text": "The preview cuts off."
 },
 {
  "i": 73,
  "start": 150.634,
  "end": 151.786,
  "text": "Going to the what?"
 },
 {
  "i": 74,
  "start": 152.286,
  "end": 157.854,
  "text": "In one study, eighty-nine percent of college students said they'd felt their phone buzz when it hadn't."
 },
 {
  "i": 75,
  "start": 158.004,
  "end": 159.519,
  "text": "Phantom vibrations."
 },
 {
  "i": 76,
  "start": 159.669,
  "end": 160.757,
  "text": "You never wonder."
 },
 {
  "i": 77,
  "start": 160.907,
  "end": 162.613,
  "text": "You already know who's texting."
 },
 {
  "i": 78,
  "start": 162.763,
  "end": 164.107,
  "text": "So you ask first."
 },
 {
  "i": 79,
  "start": 164.607,
  "end": 165.311,
  "text": "Wait."
 },
 {
  "i": 80,
  "start": 165.461,
  "end": 167.275,
  "text": "I was literally about to ask you."
 },
 {
  "i": 81,
  "start": 167.775,
  "end": 168.713,
  "text": "Day six."
 },
 {
  "i": 82,
  "start": 168.863,
  "end": 170.975,
  "text": "You start a group chat called Called It."
 },
 {
  "i": 83,
  "start": 171.125,
  "end": 173.365,
  "text": "You post tomorrow's alerts a day early."
 },
 {
  "i": 84,
  "start": 173.515,
  "end": 174.497,
  "text": "Snow day."
 },
 {
  "i": 85,
  "start": 174.647,
  "end": 175.82,
  "text": "Lockdown drill."
 },
 {
  "i": 86,
  "start": 175.97,
  "end": 179.042,
  "text": "The cafeteria running out of pizza at 12:14."
 },
 {
  "i": 87,
  "start": 179.542,
  "end": 181.953,
  "text": "Within a day, two thousand kids follow it."
 },
 {
  "i": 88,
  "start": 182.453,
  "end": 183.349,
  "text": "Okay."
 },
 {
  "i": 89,
  "start": 183.499,
  "end": 185.035,
  "text": "Who is leaking this?"
 },
 {
  "i": 90,
  "start": 185.535,
  "end": 187.924,
  "text": "Then a text from Jordan lands a day early."
 },
 {
  "i": 91,
  "start": 188.074,
  "end": 189.868,
  "text": "Tomorrow, 2:05 p.m."
 },
 {
  "i": 92,
  "start": 189.868,
  "end": 192.639,
  "text": "Jordan: failed my driving test lol."
 },
 {
  "i": 93,
  "start": 192.789,
  "end": 195.861,
  "text": "So tonight, you quiz Jordan on parallel parking."
 },
 {
  "i": 94,
  "start": 196.011,
  "end": 197.185,
  "text": "For two hours."
 },
 {
  "i": 95,
  "start": 197.335,
  "end": 198.572,
  "text": "In the school lot."
 },
 {
  "i": 96,
  "start": 198.722,
  "end": 201.41,
  "text": "With traffic cones you borrowed from the gym."
 },
 {
  "i": 97,
  "start": 201.91,
  "end": 202.699,
  "text": "I passed!"
 },
 {
  "i": 98,
  "start": 202.849,
  "end": 204.151,
  "text": "I actually passed!"
 },
 {
  "i": 99,
  "start": 204.651,
  "end": 206.293,
  "text": "You've never felt this good."
 },
 {
  "i": 100,
  "start": 206.443,
  "end": 208.769,
  "text": "You're not just reading tomorrow anymore."
 },
 {
  "i": 101,
  "start": 208.919,
  "end": 209.985,
  "text": "You're editing it."
 },
 {
  "i": 102,
  "start": 210.485,
  "end": 211.317,
  "text": "The catch?"
 },
 {
  "i": 103,
  "start": 211.467,
  "end": 212.427,
  "text": "Day seven."
 },
 {
  "i": 104,
  "start": 212.577,
  "end": 214.625,
  "text": "Tomorrow, 4:22 p.m."
 },
 {
  "i": 105,
  "start": 214.625,
  "end": 217.697,
  "text": "Sam: i fell off my skateboard arm hurts."
 },
 {
  "i": 106,
  "start": 218.197,
  "end": 220.416,
  "text": "So you hide the skateboard under your bed."
 },
 {
  "i": 107,
  "start": 220.566,
  "end": 221.782,
  "text": "Problem solved."
 },
 {
  "i": 108,
  "start": 221.932,
  "end": 224.3,
  "text": "At 11:59, the list updates."
 },
 {
  "i": 109,
  "start": 224.45,
  "end": 226.242,
  "text": "The skateboard message is gone."
 },
 {
  "i": 110,
  "start": 226.392,
  "end": 227.949,
  "text": "In its place, two new ones."
 },
 {
  "i": 111,
  "start": 228.449,
  "end": 229.672,
  "text": "4:22 p.m."
 },
 {
  "i": 112,
  "start": 229.672,
  "end": 231.543,
  "text": "Sam: tripped on the stairs."
 },
 {
  "i": 113,
  "start": 231.693,
  "end": 233.173,
  "text": "4:23 p.m."
 },
 {
  "i": 114,
  "start": 233.173,
  "end": 235.511,
  "text": "Mom: Taking Sam to urgent care."
 },
 {
  "i": 115,
  "start": 236.011,
  "end": 238.657,
  "text": "It's a sprained ankle, not a broken arm."
 },
 {
  "i": 116,
  "start": 238.807,
  "end": 239.511,
  "text": "Better."
 },
 {
  "i": 117,
  "start": 239.661,
  "end": 240.813,
  "text": "But not gone."
 },
 {
  "i": 118,
  "start": 240.963,
  "end": 242.051,
  "text": "That's the cost."
 },
 {
  "i": 119,
  "start": 242.201,
  "end": 245.678,
  "text": "Erase one notification, and tomorrow sends back two."
 },
 {
  "i": 120,
  "start": 245.828,
  "end": 247.236,
  "text": "Tomorrow keeps count."
 },
 {
  "i": 121,
  "start": 247.736,
  "end": 249.656,
  "text": "Forty-six becomes forty-eight."
 },
 {
  "i": 122,
  "start": 249.806,
  "end": 251.022,
  "text": "Then fifty-two."
 },
 {
  "i": 123,
  "start": 251.172,
  "end": 252.281,
  "text": "Then sixty."
 },
 {
  "i": 124,
  "start": 252.431,
  "end": 254.586,
  "text": "By day nine, one hundred and four."
 },
 {
  "i": 125,
  "start": 254.736,
  "end": 256.165,
  "text": "You can read tomorrow."
 },
 {
  "i": 126,
  "start": 256.315,
  "end": 257.659,
  "text": "You can't answer it."
 },
 {
  "i": 127,
  "start": 258.159,
  "end": 259.994,
  "text": "Every erase is for someone."
 },
 {
  "i": 128,
  "start": 260.144,
  "end": 261.339,
  "text": "Jordan's test."
 },
 {
  "i": 129,
  "start": 261.489,
  "end": 262.939,
  "text": "Ava's flat tire."
 },
 {
  "i": 130,
  "start": 263.089,
  "end": 263.553,
  "text": "Mr."
 },
 {
  "i": 131,
  "start": 263.553,
  "end": 264.945,
  "text": "Okafor's coffee spill."
 },
 {
  "i": 132,
  "start": 265.095,
  "end": 267.698,
  "text": "And for every one, tomorrow sends back two."
 },
 {
  "i": 133,
  "start": 267.848,
  "end": 269.064,
  "text": "Doubling is sneaky."
 },
 {
  "i": 134,
  "start": 269.214,
  "end": 273.843,
  "text": "Start with one and double it ten times, and you get one thousand and twenty-four."
 },
 {
  "i": 135,
  "start": 273.993,
  "end": 277.556,
  "text": "You do that math at 3 a.m., and then you stop doing math."
 },
 {
  "i": 136,
  "start": 278.056,
  "end": 280.701,
  "text": "Every night you're up until three, erasing."
 },
 {
  "i": 137,
  "start": 280.851,
  "end": 283.497,
  "text": "Teenagers need eight to ten hours of sleep."
 },
 {
  "i": 138,
  "start": 283.647,
  "end": 284.799,
  "text": "You're getting four."
 },
 {
  "i": 139,
  "start": 284.949,
  "end": 286.058,
  "text": "Nine nights."
 },
 {
  "i": 140,
  "start": 286.208,
  "end": 288.768,
  "text": "That's about forty hours you'll never get back."
 },
 {
  "i": 141,
  "start": 289.268,
  "end": 290.761,
  "text": "You look like a raccoon."
 },
 {
  "i": 142,
  "start": 290.911,
  "end": 292.277,
  "text": "A tired raccoon."
 },
 {
  "i": 143,
  "start": 292.777,
  "end": 294.628,
  "text": "Then, tomorrow, 9:00 a.m."
 },
 {
  "i": 144,
  "start": 294.628,
  "end": 296.745,
  "text": "Email: Priya Shah, Hindsight Labs."
 },
 {
  "i": 145,
  "start": 296.895,
  "end": 298.473,
  "text": "We've been watching Called It..."
 },
 {
  "i": 146,
  "start": 298.973,
  "end": 302.045,
  "text": "Priya is calm, polite, and very expensive-looking."
 },
 {
  "i": 147,
  "start": 302.545,
  "end": 304.487,
  "text": "We'd like to buy the phone."
 },
 {
  "i": 148,
  "start": 304.637,
  "end": 306.258,
  "text": "Two million dollars."
 },
 {
  "i": 149,
  "start": 306.408,
  "end": 308.883,
  "text": "Tomorrow, six p.m., our office."
 },
 {
  "i": 150,
  "start": 309.033,
  "end": 313.065,
  "text": "At 6:15, it goes into our shielded case for twenty-four hours."
 },
 {
  "i": 151,
  "start": 313.565,
  "end": 315.335,
  "text": "She already knows everything."
 },
 {
  "i": 152,
  "start": 315.835,
  "end": 317.755,
  "text": "Sixty-three predictions."
 },
 {
  "i": 153,
  "start": 317.905,
  "end": 319.74,
  "text": "Sixty-three correct."
 },
 {
  "i": 154,
  "start": 320.24,
  "end": 326.427,
  "text": "If each one were a coin flip, the odds of guessing all sixty-three are about one in nine quintillion."
 },
 {
  "i": 155,
  "start": 326.577,
  "end": 329.094,
  "text": "Hindsight Labs does not believe in luck."
 },
 {
  "i": 156,
  "start": 329.594,
  "end": 335.503,
  "text": "A shielded case is basically a Faraday cage, a metal box that blocks radio signals."
 },
 {
  "i": 157,
  "start": 335.653,
  "end": 336.805,
  "text": "Nothing gets in."
 },
 {
  "i": 158,
  "start": 336.955,
  "end": 338.214,
  "text": "Nothing gets out."
 },
 {
  "i": 159,
  "start": 338.364,
  "end": 339.857,
  "text": "Not even a phone call."
 },
 {
  "i": 160,
  "start": 340.007,
  "end": 341.351,
  "text": "Two million dollars."
 },
 {
  "i": 161,
  "start": 341.501,
  "end": 343.421,
  "text": "Mom could stop working doubles."
 },
 {
  "i": 162,
  "start": 343.921,
  "end": 348.465,
  "text": "That night, Mom falls asleep on the couch in her scrubs, still wearing her shoes."
 },
 {
  "i": 163,
  "start": 348.615,
  "end": 350.77,
  "text": "On the table, a pile of envelopes."
 },
 {
  "i": 164,
  "start": 350.92,
  "end": 352.264,
  "text": "Two of them are red."
 },
 {
  "i": 165,
  "start": 352.764,
  "end": 353.681,
  "text": "Day ten."
 },
 {
  "i": 166,
  "start": 353.831,
  "end": 355.194,
  "text": "11:59 p.m."
 },
 {
  "i": 167,
  "start": 355.194,
  "end": 357.991,
  "text": "Three hundred and twelve notifications."
 },
 {
  "i": 168,
  "start": 358.141,
  "end": 359.443,
  "text": "Your thumb is shaking."
 },
 {
  "i": 169,
  "start": 359.593,
  "end": 360.553,
  "text": "You scroll."
 },
 {
  "i": 170,
  "start": 360.703,
  "end": 361.471,
  "text": "Spam."
 },
 {
  "i": 171,
  "start": 361.621,
  "end": 362.41,
  "text": "School."
 },
 {
  "i": 172,
  "start": 362.56,
  "end": 363.328,
  "text": "Tyler."
 },
 {
  "i": 173,
  "start": 363.478,
  "end": 364.225,
  "text": "Ava."
 },
 {
  "i": 174,
  "start": 364.375,
  "end": 366.551,
  "text": "Then one line that wasn't there before."
 },
 {
  "i": 175,
  "start": 367.051,
  "end": 368.817,
  "text": "Tomorrow, 6:12 p.m."
 },
 {
  "i": 176,
  "start": 368.817,
  "end": 370.101,
  "text": "Missed call: Mom."
 },
 {
  "i": 177,
  "start": 370.251,
  "end": 371.147,
  "text": "Fourteen."
 },
 {
  "i": 178,
  "start": 371.647,
  "end": 373.546,
  "text": "Missed calls from Mom aren't news."
 },
 {
  "i": 179,
  "start": 373.696,
  "end": 376.789,
  "text": "She called you nine times last Tuesday about a sweater."
 },
 {
  "i": 180,
  "start": 376.939,
  "end": 377.643,
  "text": "Still."
 },
 {
  "i": 181,
  "start": 377.793,
  "end": 379.329,
  "text": "In the morning, you call her."
 },
 {
  "i": 182,
  "start": 379.829,
  "end": 380.811,
  "text": "I'm fine, honey."
 },
 {
  "i": 183,
  "start": 380.961,
  "end": 381.643,
  "text": "Day off."
 },
 {
  "i": 184,
  "start": 381.793,
  "end": 382.988,
  "text": "I'm making lasagna."
 },
 {
  "i": 185,
  "start": 383.488,
  "end": 384.213,
  "text": "Fine."
 },
 {
  "i": 186,
  "start": 384.363,
  "end": 385.366,
  "text": "She's fine."
 },
 {
  "i": 187,
  "start": 385.516,
  "end": 388.609,
  "text": "And the list won't update until 11:59."
 },
 {
  "i": 188,
  "start": 388.759,
  "end": 390.53,
  "text": "Tonight is too late to check."
 },
 {
  "i": 189,
  "start": 391.03,
  "end": 394.593,
  "text": "At 5:15, you stand at the front door for a full minute."
 },
 {
  "i": 190,
  "start": 394.743,
  "end": 396.129,
  "text": "Downtown, or home."
 },
 {
  "i": 191,
  "start": 396.279,
  "end": 399.138,
  "text": "In the kitchen, Mom is singing along to the radio."
 },
 {
  "i": 192,
  "start": 399.288,
  "end": 400.077,
  "text": "Badly."
 },
 {
  "i": 193,
  "start": 400.227,
  "end": 401.23,
  "text": "She's fine."
 },
 {
  "i": 194,
  "start": 401.38,
  "end": 402.724,
  "text": "Two million dollars."
 },
 {
  "i": 195,
  "start": 402.874,
  "end": 403.663,
  "text": "You go."
 },
 {
  "i": 196,
  "start": 404.163,
  "end": 405.571,
  "text": "Bring me back a fancy pen!"
 },
 {
  "i": 197,
  "start": 406.071,
  "end": 408.909,
  "text": "At six, you're downtown, forty minutes from home."
 },
 {
  "i": 198,
  "start": 409.059,
  "end": 410.339,
  "text": "Hindsight Labs."
 },
 {
  "i": 199,
  "start": 410.489,
  "end": 411.918,
  "text": "Twenty-second floor."
 },
 {
  "i": 200,
  "start": 412.418,
  "end": 414.935,
  "text": "Phones on Do Not Disturb, please."
 },
 {
  "i": 201,
  "start": 415.085,
  "end": 416.792,
  "text": "The lawyers insist."
 },
 {
  "i": 202,
  "start": 417.292,
  "end": 418.807,
  "text": "Priya turns the pages."
 },
 {
  "i": 203,
  "start": 418.957,
  "end": 419.874,
  "text": "Sign here."
 },
 {
  "i": 204,
  "start": 420.024,
  "end": 421.155,
  "text": "Initial here."
 },
 {
  "i": 205,
  "start": 421.305,
  "end": 422.457,
  "text": "6:09."
 },
 {
  "i": 206,
  "start": 422.607,
  "end": 423.588,
  "text": "6:10."
 },
 {
  "i": 207,
  "start": 423.738,
  "end": 424.847,
  "text": "6:11."
 },
 {
  "i": 208,
  "start": 425.347,
  "end": 426.414,
  "text": "6:12."
 },
 {
  "i": 209,
  "start": 426.564,
  "end": 428.377,
  "text": "Your phone lights up on the table."
 },
 {
  "i": 210,
  "start": 428.527,
  "end": 429.53,
  "text": "No sound."
 },
 {
  "i": 211,
  "start": 429.68,
  "end": 430.427,
  "text": "Mom."
 },
 {
  "i": 212,
  "start": 430.577,
  "end": 432.411,
  "text": "Do Not Disturb swallows it."
 },
 {
  "i": 213,
  "start": 432.561,
  "end": 433.479,
  "text": "Call two."
 },
 {
  "i": 214,
  "start": 433.629,
  "end": 434.567,
  "text": "Call three."
 },
 {
  "i": 215,
  "start": 435.067,
  "end": 436.39,
  "text": "And then you hear it."
 },
 {
  "i": 216,
  "start": 436.54,
  "end": 437.777,
  "text": "Not out loud."
 },
 {
  "i": 217,
  "start": 437.927,
  "end": 438.951,
  "text": "In your head."
 },
 {
  "i": 218,
  "start": 439.451,
  "end": 440.71,
  "text": "Put me in your favorites."
 },
 {
  "i": 219,
  "start": 440.86,
  "end": 442.161,
  "text": "So I always get through."
 },
 {
  "i": 220,
  "start": 442.661,
  "end": 443.685,
  "text": "You never did."
 },
 {
  "i": 221,
  "start": 443.835,
  "end": 445.734,
  "text": "Under the table, your thumb moves."
 },
 {
  "i": 222,
  "start": 445.884,
  "end": 446.844,
  "text": "Contacts."
 },
 {
  "i": 223,
  "start": 446.994,
  "end": 447.741,
  "text": "Mom."
 },
 {
  "i": 224,
  "start": 447.891,
  "end": 449.171,
  "text": "Add to Favorites."
 },
 {
  "i": 225,
  "start": 449.321,
  "end": 450.579,
  "text": "Call five rings."
 },
 {
  "i": 226,
  "start": 450.729,
  "end": 451.753,
  "text": "Out loud."
 },
 {
  "i": 227,
  "start": 452.253,
  "end": 453.171,
  "text": "You answer."
 },
 {
  "i": 228,
  "start": 453.321,
  "end": 455.241,
  "text": "Her words are coming out wrong."
 },
 {
  "i": 229,
  "start": 455.391,
  "end": 456.137,
  "text": "Slow."
 },
 {
  "i": 230,
  "start": 456.287,
  "end": 456.927,
  "text": "Thick."
 },
 {
  "i": 231,
  "start": 457.427,
  "end": 458.046,
  "text": "Maya..."
 },
 {
  "i": 232,
  "start": 458.196,
  "end": 458.9,
  "text": "my arm..."
 },
 {
  "i": 233,
  "start": 459.05,
  "end": 459.647,
  "text": "can't..."
 },
 {
  "i": 234,
  "start": 460.147,
  "end": 461.854,
  "text": "Doctors have a word for this."
 },
 {
  "i": 235,
  "start": 462.004,
  "end": 462.751,
  "text": "FAST."
 },
 {
  "i": 236,
  "start": 462.901,
  "end": 464.01,
  "text": "Face drooping."
 },
 {
  "i": 237,
  "start": 464.16,
  "end": 465.355,
  "text": "Arm weakness."
 },
 {
  "i": 238,
  "start": 465.505,
  "end": 466.891,
  "text": "Speech difficulty."
 },
 {
  "i": 239,
  "start": 467.041,
  "end": 468.833,
  "text": "Time to call 911."
 },
 {
  "i": 240,
  "start": 468.983,
  "end": 474.061,
  "text": "During a stroke, the brain can lose around one point nine million neurons every minute."
 },
 {
  "i": 241,
  "start": 474.561,
  "end": 475.649,
  "text": "6:13."
 },
 {
  "i": 242,
  "start": 475.799,
  "end": 477.249,
  "text": "You call 911."
 },
 {
  "i": 243,
  "start": 477.399,
  "end": 478.807,
  "text": "One point nine million."
 },
 {
  "i": 244,
  "start": 478.957,
  "end": 480.045,
  "text": "6:14."
 },
 {
  "i": 245,
  "start": 480.195,
  "end": 481.179,
  "text": "You call Mrs."
 },
 {
  "i": 246,
  "start": 481.179,
  "end": 482.286,
  "text": "Alvarez next door."
 },
 {
  "i": 247,
  "start": 482.436,
  "end": 483.524,
  "text": "She has a key."
 },
 {
  "i": 248,
  "start": 483.674,
  "end": 485.039,
  "text": "Three point eight million."
 },
 {
  "i": 249,
  "start": 485.539,
  "end": 486.819,
  "text": "I'm going."
 },
 {
  "i": 250,
  "start": 486.969,
  "end": 488.271,
  "text": "I'm going!"
 },
 {
  "i": 251,
  "start": 488.771,
  "end": 489.837,
  "text": "6:15."
 },
 {
  "i": 252,
  "start": 490.337,
  "end": 491.255,
  "text": "Maya."
 },
 {
  "i": 253,
  "start": 491.405,
  "end": 493.026,
  "text": "It's 6:15."
 },
 {
  "i": 254,
  "start": 493.176,
  "end": 494.093,
  "text": "The case."
 },
 {
  "i": 255,
  "start": 494.243,
  "end": 496.185,
  "text": "Now, or the deal is off."
 },
 {
  "i": 256,
  "start": 496.685,
  "end": 498.05,
  "text": "The deal, or the call."
 },
 {
  "i": 257,
  "start": 498.55,
  "end": 500.129,
  "text": "You keep the phone at your ear."
 },
 {
  "i": 258,
  "start": 500.279,
  "end": 501.751,
  "text": "Mom can't talk much."
 },
 {
  "i": 259,
  "start": 501.901,
  "end": 503.287,
  "text": "But she can hear you."
 },
 {
  "i": 260,
  "start": 503.437,
  "end": 504.504,
  "text": "So you talk."
 },
 {
  "i": 261,
  "start": 505.004,
  "end": 505.473,
  "text": "No."
 },
 {
  "i": 262,
  "start": 505.973,
  "end": 508.661,
  "text": "You're walking away from two million dollars."
 },
 {
  "i": 263,
  "start": 509.161,
  "end": 510.569,
  "text": "I'm walking toward my mom."
 },
 {
  "i": 264,
  "start": 511.069,
  "end": 512.243,
  "text": "6:17."
 },
 {
  "i": 265,
  "start": 512.393,
  "end": 512.835,
  "text": "Mrs."
 },
 {
  "i": 266,
  "start": 512.835,
  "end": 514.099,
  "text": "Alvarez: I'm with her."
 },
 {
  "i": 267,
  "start": 514.249,
  "end": 515.252,
  "text": "She's awake."
 },
 {
  "i": 268,
  "start": 515.402,
  "end": 516.959,
  "text": "Seven point six million."
 },
 {
  "i": 269,
  "start": 517.109,
  "end": 518.347,
  "text": "6:21."
 },
 {
  "i": 270,
  "start": 518.497,
  "end": 519.414,
  "text": "Sirens."
 },
 {
  "i": 271,
  "start": 519.564,
  "end": 520.993,
  "text": "You can read tomorrow."
 },
 {
  "i": 272,
  "start": 521.143,
  "end": 522.487,
  "text": "You can't answer it."
 },
 {
  "i": 273,
  "start": 522.637,
  "end": 524.301,
  "text": "But you can answer today."
 },
 {
  "i": 274,
  "start": 524.801,
  "end": 527.916,
  "text": "Clot-busting drugs work best within about three hours."
 },
 {
  "i": 275,
  "start": 528.066,
  "end": 530.093,
  "text": "Mom gets them in fifty-one minutes."
 },
 {
  "i": 276,
  "start": 530.593,
  "end": 532.086,
  "text": "You got her here in time."
 },
 {
  "i": 277,
  "start": 532.586,
  "end": 534.399,
  "text": "Mom's words are still slow."
 },
 {
  "i": 278,
  "start": 534.549,
  "end": 535.744,
  "text": "But they're hers."
 },
 {
  "i": 279,
  "start": 536.244,
  "end": 536.991,
  "text": "Told you."
 },
 {
  "i": 280,
  "start": 537.141,
  "end": 537.93,
  "text": "Favorites."
 },
 {
  "i": 281,
  "start": 538.43,
  "end": 541.353,
  "text": "Sam wakes up and climbs onto the end of the bed."
 },
 {
  "i": 282,
  "start": 541.503,
  "end": 542.804,
  "text": "You open your phone."
 },
 {
  "i": 283,
  "start": 542.954,
  "end": 543.765,
  "text": "Called It."
 },
 {
  "i": 284,
  "start": 543.915,
  "end": 545.429,
  "text": "Two thousand followers."
 },
 {
  "i": 285,
  "start": 545.579,
  "end": 546.625,
  "text": "You delete it."
 },
 {
  "i": 286,
  "start": 546.775,
  "end": 550.444,
  "text": "Then you open Contacts, and you add Sam to your favorites too."
 },
 {
  "i": 287,
  "start": 550.944,
  "end": 551.456,
  "text": "See?"
 },
 {
  "i": 288,
  "start": 551.606,
  "end": 552.523,
  "text": "Later means never."
 },
 {
  "i": 289,
  "start": 552.673,
  "end": 553.505,
  "text": "Now means now."
 },
 {
  "i": 290,
  "start": 554.005,
  "end": 555.392,
  "text": "Is any of this real?"
 },
 {
  "i": 291,
  "start": 555.542,
  "end": 557.441,
  "text": "A phone that reads tomorrow, no."
 },
 {
  "i": 292,
  "start": 557.591,
  "end": 562.199,
  "text": "But favorites that break through Do Not Disturb are real; most phones have them."
 },
 {
  "i": 293,
  "start": 562.349,
  "end": 563.693,
  "text": "And FAST is real."
 },
 {
  "i": 294,
  "start": 563.843,
  "end": 567.619,
  "text": "In the U.S., someone has a stroke about every forty seconds."
 },
 {
  "i": 295,
  "start": 567.769,
  "end": 570.414,
  "text": "If you see the signs, don't wait for tomorrow."
 },
 {
  "i": 296,
  "start": 570.564,
  "end": 571.247,
  "text": "Call."
 },
 {
  "i": 297,
  "start": 571.747,
  "end": 573.645,
  "text": "That night, 11:59."
 },
 {
  "i": 298,
  "start": 573.795,
  "end": 575.075,
  "text": "One notification."
 },
 {
  "i": 299,
  "start": 575.225,
  "end": 576.143,
  "text": "Just one."
 },
 {
  "i": 300,
  "start": 576.643,
  "end": 577.958,
  "text": "Tomorrow, 6:00 a.m."
 },
 {
  "i": 301,
  "start": 577.958,
  "end": 580.291,
  "text": "Unknown number: I know you can see this."
 },
 {
  "i": 302,
  "start": 580.791,
  "end": 584.993,
  "text": "If your phone showed you tomorrow, would you read it every night, or turn it off?"
 },
 {
  "i": 303,
  "start": 585.143,
  "end": 586.573,
  "text": "Tell us in the comments."
 }
]